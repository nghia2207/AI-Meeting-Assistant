{
  "manifest_version": 3,
  "name": "AI Meeting Assistant",
  "version": "1.0.0",
  "description": "Auto-record Google Meet, transcribe with Whisper, summarize with Gemini, extract action items",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "tabCapture"
  ],
  "host_permissions": [
    "*://meet.google.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": "assets/icon.svg"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://meet.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "assets/icon.svg"
  }
}